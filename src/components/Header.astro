---
import { nav, site } from "../data/site";
---

<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="#top" aria-label={`${site.name}, home`}>
      <svg class="glyph" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="14.5" stroke="currentColor" />
        <path
          d="M16 4v24M4 16h24M16 16l7.8-7.8M16 16l-7.8 7.8M16 16l7.8 7.8M16 16L8.2 8.2"
          stroke="currentColor"
          stroke-width="1"
        />
        <circle cx="16" cy="16" r="2.4" fill="currentColor" />
      </svg>
      <span>
        <span class="name">{site.short}</span>
        <span class="sub">Landscape Co. · Est. {site.since}</span>
      </span>
    </a>

    <nav class="primary" aria-label="Primary">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="head-actions">
      <button class="icon-btn" id="theme-toggle" aria-label="Toggle color theme" type="button">
        <svg class="moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6" />
          <path
            d="M12 2v3M12 19v3M2 12h3M19 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M19.4 4.6l-2.1 2.1M6.7 17.3l-2.1 2.1"
            stroke="currentColor"
            stroke-width="1.6"
          />
        </svg>
      </button>
      <a href="#contact" class="btn btn-solid head-cta">Request a site walk</a>
      <button
        class="icon-btn menu-toggle"
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        type="button"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a href="#contact" class="btn btn-solid">Request a site walk</a>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const open = menu?.hasAttribute("hidden");
    if (open) {
      menu?.removeAttribute("hidden");
      toggle.setAttribute("aria-expanded", "true");
    } else {
      menu?.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
    }
  });

  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A") {
      menu.setAttribute("hidden", "");
      toggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>
