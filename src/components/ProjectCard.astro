---
import type { Project } from "../data/projects";
import ProjectPlan from "./ProjectPlan.astro";

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="project reveal">
  <ProjectPlan slug={project.slug} label={project.title} />
  <div class="body">
    <p class="label loc">{project.location}</p>
    <h3>{project.title}</h3>
    <p class="note">{project.note}</p>
    <div class="tags">
      {project.tags.map((tag) => <span>{tag}</span>)}
    </div>
  </div>
</article>
