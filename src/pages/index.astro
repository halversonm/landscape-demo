---
import Layout from "../layouts/Layout.astro";
import SitePlan from "../components/SitePlan.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import ContactForm from "../components/ContactForm.astro";
import { site, stats } from "../data/site";
import { services } from "../data/services";
import { phases } from "../data/process";
import { projects } from "../data/projects";
import { testimonials } from "../data/testimonials";
import { serviceAreas } from "../data/serviceArea";
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="reveal">
        <p class="label sheet-tag">
          <b>L—100</b> <span>Landscape design &amp; build · Twin Cities</span>
        </p>
        <h1>{site.tagline}</h1>
        <p class="lede">
          We draw the whole property first — grades, drainage, planting, stone — then our own crews
          build it. One plan set, one team, from the first site walk to the last plant watered in.
        </p>
        <div class="hero-cta">
          <a href="#contact" class="btn btn-solid">Request a site walk</a>
          <a href="#work" class="btn btn-ghost">See selected work</a>
        </div>
        <div class="hero-legend">
          <div>
            <svg class="key" viewBox="0 0 22 12" aria-hidden="true"><path d="M0 6h22" stroke="var(--plan)" stroke-width="1.4" stroke-dasharray="1 3" /></svg>
            Property line
          </div>
          <div>
            <svg class="key" viewBox="0 0 22 12" aria-hidden="true"><path d="M0 9C6 9 6 3 11 3s5 6 11 6" stroke="var(--plan)" stroke-width="1.2" fill="none" /></svg>
            Contour, 1 ft
          </div>
          <div>
            <svg class="key" viewBox="0 0 22 12" aria-hidden="true"><circle cx="11" cy="6" r="4.4" stroke="var(--accent)" stroke-width="1.2" fill="none" /><path d="M11 .8v10.4M5.8 6h10.4" stroke="var(--accent)" stroke-width="0.8" /></svg>
            Proposed tree
          </div>
          <div>
            <svg class="key" viewBox="0 0 22 12" aria-hidden="true"><rect x="1" y="2" width="20" height="8" fill="var(--accent)" fill-opacity="0.16" stroke="var(--accent)" stroke-width="1" stroke-dasharray="2 2" /></svg>
            Planting bed
          </div>
        </div>
      </div>

      <div class="reveal">
        <SitePlan />
        <p class="label" style="margin-top:0.9rem;color:var(--ink-soft)">
          Kenwood, Minneapolis — courtyard garden
        </p>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="band-dark stats-band">
    <div class="wrap">
      <div class="stats reveal">
        {stats.map((s) => (
          <div class="stat">
            <div class="n">{s.n}</div>
            <div class="k">{s.k}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="label sheet-tag"><b>L—200</b> <span>Scope of work</span></p>
        <h2>Everything that happens between the survey and the first frost.</h2>
        <p>
          Most projects use three or four of these. We scope them together so grades, drainage, and
          planting are solved on one drawing instead of six change orders.
        </p>
      </div>

      <div class="schedule reveal">
        {services.map((service) => (
          <div class="svc">
            <ServiceIcon icon={service.icon} />
            <h3>{service.name}</h3>
            <p class="desc">{service.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" class="section band-dark">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="label sheet-tag"><b>L—300</b> <span>Method</span></p>
        <h2>Four phases. You approve the drawings before anyone breaks ground.</h2>
      </div>
      <div class="steps reveal">
        {phases.map((phase) => (
          <div class="step">
            <div class="sh">{phase.sheet}</div>
            <h3>{phase.name}</h3>
            <p>{phase.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="label sheet-tag"><b>L—400</b> <span>Selected work</span></p>
        <h2>A few plans we drew and then built.</h2>
        <p>Every thumbnail below is the site-plan diagram for the project — north up, contours at one foot.</p>
      </div>
      <div class="work-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section band-dark">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="label sheet-tag"><b>L—410</b> <span>From the clients</span></p>
        <h2>What people say after a season in the yard.</h2>
      </div>
      <div class="quotes reveal">
        {testimonials.map((t) => (
          <figure class="quote">
            <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
            <figcaption><b>{t.name}</b><br />{t.detail}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICE AREA -->
  <section id="area" class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="label sheet-tag"><b>L—500</b> <span>Where we work</span></p>
        <h2>We have the Twin Cities covered.</h2>
        <p>
          Our office is pinned on the map. The list below shows areas we frequently are visiting.
        </p>
      </div>
      <div class="area-grid">
        <ServiceAreaMap />
        <ul class="area-list reveal">
          {serviceAreas.map((place) => <li>{place}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section band-dark">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="label sheet-tag"><b>L—600</b> <span>Start a project</span></p>
        <h2>Tell us about the property. We&rsquo;ll set up a site walk.</h2>
        <p>
          We book design work about six weeks out and installs one to two seasons out. Reaching out
          now is the right time for next year.
        </p>
      </div>

      <div class="contact-grid">
        <div class="reveal">
          <ContactForm />
        </div>
        <div class="reveal">
          <dl class="contact-detail">
            <div><dt>Phone</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
            <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
            <div><dt>Yard &amp; shop</dt><dd>{site.address[0]}<br />{site.address[1]}</dd></div>
            <div><dt>Office hours</dt><dd>{site.hours[0]}<br />{site.hours[1]}</dd></div>
            <div><dt>Licensing</dt><dd>{site.license[0]}<br />{site.license[1]}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Layout>
